# ─────────────────────────────────────────────────────────────
# SafeSight environment configuration
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# Run `bun run doctor` to verify keys, ffmpeg, and storage dirs.
# ─────────────────────────────────────────────────────────────

# ── Anthropic Claude (FALLBACK for vision triage + text reasoning) ──
# Optional but recommended. Vision triage runs on Baseten Gemma and text tasks
# on Baseten GPT OSS; Claude is used automatically only if a Baseten call fails
# or is unconfigured. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Baseten: GPT OSS 120B (text) ──
# Nurse replies, shift-handoff summary, and weekly quality report.
# Each dedicated deployment has its own URL + key. The model slug is what the
# deployment reports at GET <url>/models (often "openai/gpt-oss-120b").
BASETEN_API_KEY_GPT=
BASETEN_GPT_URL=https://model-XXXXXXX.api.baseten.co/environments/production/sync/v1
BASETEN_GPT_MODEL=openai/gpt-oss-120b

# ── Baseten: Gemma 3 27B IT (vision) ──
# Frame triage for Tab 1 / Tab 2 / Tab 3. The model slug is often just "gemma"
# for a dedicated deployment — check GET <url>/models.
BASETEN_API_KEY_GEMMA=
BASETEN_GEMMA_URL=https://model-XXXXXXX.api.baseten.co/environments/production/sync/v1
BASETEN_GEMMA_MODEL=gemma

# ── ElevenLabs TTS (spoken alerts: Tab 1 + critical Tab 3 alerts) ──
# https://elevenlabs.io — voice id is the ElevenLabs voice to speak with.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Tab 3 live monitor ──
# Tab 3 captures camera frames in the browser and sends them to the Baseten
# Gemma vision endpoint. NEXT_PUBLIC_* is exposed to the browser by design.
# How often to capture + analyze a frame, in ms (default 4000). Higher = cheaper
# / lower load; lower = more responsive.
NEXT_PUBLIC_LIVE_FRAME_INTERVAL_MS=4000

# ── Photon / Spectrum iMessage alerts (Tab 3 urgent/critical) ──
# Local mode (macOS, uses the Mac's own Messages app): set PHOTON_IMESSAGE_LOCAL=true
# and leave the project vars empty. Requires Full Disk Access for your terminal.
# Cloud mode: set PHOTON_PROJECT_ID + PHOTON_PROJECT_SECRET and PHOTON_IMESSAGE_LOCAL=false.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_IMESSAGE_LOCAL=true
# Phone number (E.164, e.g. +15551234567) that receives alerts and can reply.
NURSE_PHONE=

# ── Spectrum alert worker (separate process: `bun run spectrum-worker`) ──
# Shared secret between the Next.js app and the worker (optional but recommended).
SPECTRUM_ALERT_WORKER_SECRET=
# Override if the worker runs somewhere other than the default.
SPECTRUM_ALERT_WORKER_URL=http://127.0.0.1:39847
SPECTRUM_ALERT_WORKER_PORT=39847

# ── Behavior toggles ──
# Alerts are MOCKED by default to protect credits. Set to false to actually
# hit the Spectrum worker + ElevenLabs.
MOCK_ALERTS=true
# Tab 2: use a fake analysis worker instead of calling the model (no API cost).
USE_STUB_WORKER=false
# Tab 3: stub live mode — posts random observations every 4s, no camera/model.
NEXT_PUBLIC_STUB_LIVE=false
